# Leave empty to run in demo mode: retrieval and extractive answers work, the agent is off.
ANTHROPIC_API_KEY=

# Every setting is optional. Defaults shown.
# COPILOT_MODEL=claude-opus-5-5
# COPILOT_ASK_EFFORT=low
# COPILOT_AGENT_EFFORT=medium
# COPILOT_MAX_TOKENS=4096
# COPILOT_MAX_AGENT_STEPS=6

# fixtures = bundled demo data, graphql = a running HireFlow API
# COPILOT_SOURCE=fixtures
# COPILOT_HIREFLOW_URL=http://localhost:5230/graphql

# Guardrails for a public key
# COPILOT_RATE_LIMIT_PER_MINUTE=5
# COPILOT_RATE_LIMIT_PER_DAY=40
# COPILOT_DAILY_BUDGET_USD=1.00
# COPILOT_ACCESS_KEY=          # require an X-Copilot-Key header on LLM endpoints

# none | console | otlp | azure (needs APPLICATIONINSIGHTS_CONNECTION_STRING)
# COPILOT_OTEL_EXPORTER=none
